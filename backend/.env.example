# Local development. Copy to backend/.env.
# With DEV_LOGIN you can run everything without a GitHub App: "Sign in" logs you in
# as a fake editor, and edits are saved to .data/bookmarks.json (starts empty; see the
# README to copy in the live list).

PORT=8788
# The frontend dev server proxies /auth and /api here, so both URLs are the Vite origin.
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000/the-compiler/

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=

DEV_LOGIN=true
DATA_DIR=.data

# To test real GitHub sign-in instead, remove DEV_LOGIN and set:
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
