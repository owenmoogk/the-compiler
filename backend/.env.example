# Local development. Copy to backend/.env.
# With LOCAL_BOOKMARKS_FILE + DEV_LOGIN you can run everything without a GitHub App:
# the file starts as a copy of the public bookmarks repo, "Sign in" logs you in
# as a fake editor, and edits stay in the local file (never pushed to GitHub).

PORT=8788
# The frontend dev server proxies /auth and /api here, so both URLs are the Vite origin.
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000/the-compiler/

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=

LOCAL_BOOKMARKS_FILE=.data/bookmarks.json
DEV_LOGIN=true
DATA_DIR=.data

# To test against real GitHub instead, remove the two lines above and set:
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# BOOKMARKS_REPO=owenmoogk/bookmarks
