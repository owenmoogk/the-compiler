# systemd unit for the-compiler backend. Copy to /etc/systemd/system/compiler.service,
# replace USER, HOME and NODE. HOME/the-compiler-app is the live release, installed by CI
# (backend/deploy/compiler-deploy.sh). Secrets live in HOME/.config/the-compiler/env (chmod 600),
# see the README. Then: sudo systemctl daemon-reload && sudo systemctl enable --now compiler
[Unit]
Description=The Compiler backend (bookmarks API)
After=network-online.target
Wants=network-online.target

[Service]
User=USER
WorkingDirectory=HOME/the-compiler-app
EnvironmentFile=HOME/.config/the-compiler/env
Environment=PORT=8788
Environment=HOST=127.0.0.1
ExecStart=NODE dist/server.js
Restart=on-failure
RestartSec=10

# Stay out of the way of anything else on the box (e.g. a game server).
Nice=10
CPUQuota=50%
MemoryMax=256M

# Hardening: only the home directory is writable (sessions in ~/.local/share/the-compiler).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=HOME
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
