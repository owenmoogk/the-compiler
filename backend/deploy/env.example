# Production secrets for the server: ~/the-compiler/secrets.env (chmod 600).
PUBLIC_URL=https://compiler.owenmoogk.com
FRONTEND_URL=https://owenmoogk.com/the-compiler/

# From the GitHub App's settings page
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=

BOOKMARKS_REPO=owenmoogk/bookmarks
BOOKMARKS_BRANCH=main
BOOKMARKS_PATH=bookmarks.json

# Local hour (0-23) to push bookmarks.json to GitHub each day.
# SYNC_HOUR=3
